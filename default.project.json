{
  "name": "Cargo Plane Game",
  "emitLegacyScripts": false,

  "tree": {
    "$className": "DataModel",
  
    "ReplicatedStorage": {
      "Client": {
        "$path": "src/Client"
      },
      "Modules": {
        "$path": "src/Modules"
      },
      "Core": {
        "$path": "src/Core",
        "Fusion": {
          "$path": "vendor/Fusion"
        }
      },
      "Remotes": {
        "$className": "Folder",
        "Plane": {
          "$className": "Folder",
          "RequestEngine": {
            "$className": "RemoteEvent"
          },
          "SetThrottle": {
            "$className": "RemoteEvent"
          },
          "ReportImpact": {
            "$className": "RemoteEvent"
          }
        },
        "NetTable": {
          "$className": "Folder",
          "Sync": {
            "$className": "RemoteEvent"
          },
          "Push": {
            "$className": "RemoteEvent"
          },
          "Request": {
            "$className": "RemoteEvent"
          }
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    }
  }
}