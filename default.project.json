{
  "name": "Cargo Plane Game",
  "emitLegacyScripts": false,

  "tree": {
    "$className": "DataModel",
  
    "ReplicatedStorage": {
      "Client": {
        "$path": "src/Client"
      },
      "Modules": {
        "$path": "src/Modules"
      },
      "Core": {
        "$path": "src/Core"
      },
      "Vendor": {
        "$className": "Folder",
        "Fusion": {
          "$path": "vendor/Fusion"
        }
      },
      "Remotes": {
        "$path": "src/Remotes",
        "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/Server"
      }
    }
  }
}