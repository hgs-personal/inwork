{
	"UI Labs Fusion Story": {
		"scope": "luau",
		"prefix": ["fusionstory", "story"],
		"description": "UI Labs story that mounts a Fusion GUI layer into the story target",
		"body": [
			"local Fusion = require(\"@game/ReplicatedStorage/Core/Fusion\")",
			"",
			"local ${1:${TM_FILENAME_BASE/(.*)\\.story$/$1/}} = require(\"./${1}\")",
			"",
			"return {",
			"\tfusion = Fusion,",
			"\tstory = function(props)",
			"\t\tlocal scope = props.scope :: Fusion.Scope",
			"\t\tlocal ${2:layer} = ${1}.new(scope)",
			"\t\tscope:Hydrate(props.target)({",
			"\t\t\t[Fusion.Children] = ${2}.mount(scope)",
			"\t\t})",
			"\tend,",
			"}",
			""
		]
	},
	"Fusion Function Component": {
		"scope": "luau",
		"prefix": ["fusioncomponent", "component"],
		"description": "Fusion function component module: (scope, props) -> Child",
		"body": [
			"local Fusion = require(\"@game/ReplicatedStorage/Core/Fusion\")",
			"",
			"local Children = Fusion.Children",
			"",
			"export type Props = {",
			"\t$2",
			"}",
			"",
			"local function ${1:$TM_FILENAME_BASE}(scope: Fusion.Scope, props: Props): Fusion.Child",
			"\treturn scope:New \"${3:Frame}\" {",
			"\t\tName = \"${1}\",",
			"\t\t$0",
			"\t}",
			"end",
			"",
			"return ${1}",
			""
		]
	}
}
